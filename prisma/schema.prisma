generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Authentication & Roles
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  status       String   @default("active") // "active", "pending", "suspended"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sessions     Session[]
  userRoles    UserRole[] // Explicit many-to-many via join table
  lectures     Lecture[]  @relation("LectureAuthor")
  questions    Question[]
  answers      Answer[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Role entity as a table to allow dynamic definition and explicit management.
// Although system roles (STUDENT, TEACHER, ADMIN) are fixed in code, modelling them 
// as data allows for future flexibility (e.g. permission granularity).
model Role {
  id          String     @id @default(uuid())
  name        String     @unique // "STUDENT", "TEACHER", "ADMIN"
  description String?
  users       UserRole[]
}

// Explicit join table for User <-> Role (Many-to-Many)
model UserRole {
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedBy String?  // ID of admin who assigned the role (audit trail)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// -----------------------------------------------------------------------------
// Core Domain: Lectures & Audio
// -----------------------------------------------------------------------------

model Lecture {
  id          String   @id @default(uuid())
  title       String
  description String?
  published   Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  author      User        @relation("LectureAuthor", fields: [authorId], references: [id])
  audioAssets AudioAsset[]
}

model AudioAsset {
  id          String   @id @default(uuid())
  lectureId   String
  title       String?  // Optional specific title for this track
  
  // Storage reference (e.g. S3 object key or full URL)
  storageKey  String
  
  // Metadata for playback
  duration    Int      // Duration in seconds
  mimeType    String   // e.g. "audio/mpeg"
  sizeBytes   Int
  
  // Offline/Playback metadata (JSON)
  // Contains segments, timestamps, repetition markers, etc.
  // Using JSONB for flexibility as segmentation logic evolves.
  metadata    Json?    

  createdAt   DateTime @default(now())

  // Relations
  lecture     Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Domain: Musaabaqah (Competitions)
// -----------------------------------------------------------------------------

model Musaabaqah {
  id          String   @id @default(uuid())
  title       String
  description String?
  
  startDate   DateTime
  endDate     DateTime
  
  // Linkage to recommended texts or memorisation targets can be added here
  // For now, simple metadata support
  rules       Json?    // Specific rules for this competition
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Domain: Q/A
// -----------------------------------------------------------------------------

model Question {
  id          String   @id @default(uuid())
  content     String
  authorId    String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  author      User     @relation(fields: [authorId], references: [id])
  answers     Answer[]
}

model Answer {
  id          String   @id @default(uuid())
  content     String
  questionId  String
  authorId    String
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
}
